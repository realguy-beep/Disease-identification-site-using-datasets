# ==========================================
# MediPredict AI Configuration Template
# Copy this file to .env and customize values
# ==========================================

# Deployment Environment ('development' or 'production')
ENVIRONMENT=development

# Server Host and Port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated list, e.g. "https://yourdomain.com,http://localhost:8000")
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Security & Admin Access
# Set a strong secret key for accessing the audit logs (/logs) and admin actions
ADMIN_API_KEY=your_secure_random_admin_api_key_here

# Data Encryption at Rest (AES-256 Fernet key for database field encryption)
# Generate a key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# Salt for hashing and pseudonymizing client IP addresses before storage
IP_HASH_SALT=your_random_salt_for_ip_hashing

# Rate Limiting (e.g. 60/minute for general endpoints, 10/minute for file uploads)
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_UPLOAD=10/minute

# Maximum File Upload Size in Megabytes (for eye scan images)
MAX_UPLOAD_SIZE_MB=5

# HTTPS Enforcement (set to True when deployed with SSL behind reverse proxy)
FORCE_HTTPS=False

